# Local-only defaults. Fine to commit for a throwaway test DB; if this
# ever becomes shared or long-lived, move these to a non-committed
# .env.local or a secrets manager instead.

MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=hotel_bookings_db
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password
MYSQL_PORT=3306
ADMINER_PORT=8080
